# Google Places API (New) key. Server-side only — never prefix with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=

# Spending cap for Places calls made by this server, in USD per calendar month.
# Requests are refused once the estimated spend would go over this.
PLACES_MONTHLY_BUDGET_USD=50

# Estimated cost of one Nearby Search call with our field mask, in USD.
# Check current pricing for the SKU your field mask hits and adjust.
PLACES_COST_PER_REQUEST_USD=0.035

# How long to reuse a Places result for the same search, in seconds (default 24h).
PLACES_CACHE_TTL_SECONDS=86400
